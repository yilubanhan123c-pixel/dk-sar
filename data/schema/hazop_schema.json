{
  "type": "object",
  "required": ["node_info", "deviations"],
  "properties": {
    "node_info": {
      "type": "object",
      "required": ["node", "parameter", "guideword", "deviation", "context"],
      "description": "HAZOP五维节点定义（HA-FCoT抽取结果）",
      "properties": {
        "node":      { "type": "string", "description": "节点/设备名称及编号，如：反应釜R-101、换热器E-201" },
        "parameter": { "type": "string", "description": "工艺参数，如：温度、压力、流量、液位、成分" },
        "guideword": {
          "type": "string",
          "enum": ["无", "过多", "过少", "反向", "部分", "其他"],
          "description": "HAZOP引导词（中文）"
        },
        "guideword_en": {
          "type": "string",
          "enum": ["NO", "MORE", "LESS", "REVERSE", "PART OF", "OTHER THAN"],
          "description": "IEC 61882标准引导词（英文）"
        },
        "deviation":  { "type": "string", "description": "偏差方向描述，如：温度偏高、压力偏低" },
        "context":    { "type": "string", "description": "操作上下文，如：正常运行、开车阶段、停车阶段" },
        "deviation_direction": {
          "type": "string",
          "enum": ["过高", "过低", "无/停止", "反向", "其他"],
          "description": "偏差方向（兼容字段）"
        },
        "normal_value":  { "type": "string", "description": "正常操作值或范围" },
        "current_value": { "type": "string", "description": "当前异常值" }
      }
    },
    "deviations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["causes", "consequences", "safeguards", "recommendations"],
        "properties": {
          "causes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "description": "可能原因列表（至少2个，最多5个）",
            "items": {
              "type": "object",
              "required": ["description", "type"],
              "properties": {
                "description": { "type": "string", "description": "原因描述" },
                "type": {
                  "type": "string",
                  "enum": ["设备故障", "操作失误", "工艺异常", "外部因素", "管理缺陷"],
                  "description": "原因类型"
                }
              }
            }
          },
          "consequences": {
            "type": "array",
            "minItems": 1,
            "description": "后果链描述（从直接后果→升级后果→极端后果）",
            "items": { "type": "string" }
          },
          "safeguards": {
            "type": "array",
            "description": "现有保护措施",
            "items": {
              "type": "object",
              "required": ["measure", "effectiveness"],
              "properties": {
                "measure": { "type": "string", "description": "保护措施名称" },
                "effectiveness": {
                  "type": "string",
                  "enum": ["有效", "部分有效", "需改进"],
                  "description": "有效性评估"
                }
              }
            }
          },
          "recommendations": {
            "type": "array",
            "minItems": 1,
            "description": "改进建议（分immediate/short_term/long_term三级）",
            "items": {
              "type": "object",
              "required": ["action", "priority", "timeframe"],
              "properties": {
                "action": { "type": "string", "description": "建议措施描述" },
                "priority": {
                  "type": "string",
                  "enum": ["高", "中", "低"],
                  "description": "优先级"
                },
                "timeframe": {
                  "type": "string",
                  "enum": ["immediate", "short_term", "long_term"],
                  "description": "实施时间框架"
                }
              }
            }
          }
        }
      }
    },
    "reasoning_chain": {
      "type": "string",
      "description": "IEC 61882链式推理逻辑描述"
    },
    "risk_level": {
      "type": "string",
      "enum": ["高", "中", "低"],
      "description": "综合风险等级"
    },
    "embedding_text": {
      "type": "string",
      "description": "用于ChromaDB向量检索的拼接文本"
    },
    "analysis_metadata": {
      "type": "object",
      "properties": {
        "referenced_cases":   { "type": "array", "items": { "type": "string" }, "description": "参考案例ID列表" },
        "reflection_rounds":  { "type": "integer", "description": "物理反思轮次" },
        "physical_issues_found": { "type": "array", "items": { "type": "string" }, "description": "发现的物理问题列表" },
        "confidence_level": {
          "type": "string",
          "enum": ["高", "中", "低"],
          "description": "分析置信度"
        }
      }
    }
  }
}
